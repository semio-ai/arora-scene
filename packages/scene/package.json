{
  "name": "@semio/scene",
  "description": "The Semio robot scene, rendered by Bevy in WebAssembly, as a React component.",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semio-ai/arora-scene.git",
    "directory": "packages/scene"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "wasm/webgpu/**",
    "wasm/webgl2/**",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "../../crates/arora-scene-wasm/build.sh",
    "build": "tsup",
    "dev": "vite example",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE && npm run build"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
